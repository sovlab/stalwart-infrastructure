# Copy this to .env and fill in real values. .env is gitignored; this
# example file is the one that gets committed.
#
# mise loads .env automatically into the shell whenever you're inside this
# project directory (see mise.toml).

# Tailscale: Admin console -> Settings -> Keys -> Generate auth key.
# Must be reusable, and tagged with the tag used in ansible/inventory/group_vars/all.yml
# (tailscale_tags). That tag must already exist under "tagOwners" in your
# tailnet's ACL policy before the key can advertise it.
TAILSCALE_AUTHKEY=

# Cloudflare: dash.cloudflare.com -> My Profile -> API Tokens -> Create Token
# Scope: Zone:DNS:Edit, restricted to your zone only.
# Required. Templated into Stalwart's configuration, which uses it both to
# publish your MX/SPF/DKIM/DMARC records and to answer the DNS-01 challenge
# when it renews its own TLS certificate. The playbook fails without it.
CLOUDFLARE_API_TOKEN=

# S3-compatible credentials for the blob store (message bodies and
# attachments). Create a bucket and an access key scoped to it only.
S3_ACCESS_KEY=
S3_SECRET_KEY=
