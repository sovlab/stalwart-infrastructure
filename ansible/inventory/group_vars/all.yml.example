---
# Copy this to all.yml (same directory) and fill in your real values.
# all.yml is gitignored; this example file is the one that gets committed.

# --- identity -----------------------------------------------------------
admin_user: CHANGEME_ADMIN_USER
admin_ssh_key: "~/.ssh/id_ed25519.pub"   # public key file for {{ admin_user }}; adjust to your actual key

domain: CHANGEME_DOMAIN.example
mail_hostname: mail.CHANGEME_DOMAIN.example       # Stalwart: SMTP / IMAP / JMAP / webadmin
webmail_hostname: webmail.CHANGEME_DOMAIN.example # Bulwark

timezone: UTC

# --- optional OVH Logs Data Platform ---------------------------------------
# Enable this only for deployments that should forward their host and
# container journal to OVH LDP. Enabling it switches Docker containers from
# json-file logging to journald, configures a bounded persistent host journal,
# and runs an unprivileged Vector collector. Vector itself keeps using Docker's
# local driver so its diagnostics cannot loop back into its own journal source.
#
# Create an LDP data stream, copy its write token to OVH_LDP_STREAM_TOKEN in
# .env, and create an IAM token for the OpenSearch ingestion endpoint as
# OVH_LDP_IAM_TOKEN. The access point is a hostname only (no scheme or port),
# e.g. gra1.logs.ovh.com.
ovh_ldp_enabled: false
ovh_ldp_cluster: CHANGEME_LDP_CLUSTER.logs.ovh.com
ovh_ldp_host: "{{ inventory_hostname }}"
ovh_ldp_iam_username: pat_jwt_mailserver

# Local retention and outage buffer. The journal is shared by all host and
# container logs; Vector's separate disk buffer holds accepted events while
# LDP is unavailable. Vector requires a disk buffer of at least ~256 MiB.
ovh_ldp_journal_max_use: 512M
ovh_ldp_journal_keep_free: 1G
ovh_ldp_journal_retention: 7day
ovh_ldp_vector_buffer_bytes: 536870912

# --- storage --------------------------------------------------------------
# A plain directory on the root filesystem: no second block volume, nothing
# to format or mount. Stalwart's local footprint here is metadata, indexes
# and the search index only - message bodies live in S3 (see below), so this
# stays small.
data_dir: /data
mailstack_dir: "{{ data_dir }}/mailstack"

# --- tailscale --------------------------------------------------------------
# Requires TAILSCALE_AUTHKEY in the environment (loaded from .env via mise).
# Must be a reusable, tagged pre-auth key from the Tailscale admin console.
# The tag (tag:mailserver below) must already exist in your tailnet's ACL
# policy under "tagOwners" before `tailscale up --advertise-tags` will work,
# otherwise the join fails with a permission error.
tailscale_authkey: "{{ lookup('ansible.builtin.env', 'TAILSCALE_AUTHKEY') }}"
tailscale_hostname: mail01
tailscale_tags:
  - tag:mailserver

# --- cloudflare -----------------------------------------------------------
# Requires CLOUDFLARE_API_TOKEN in the environment. Scope it to
# Zone:DNS:Edit on your zone only. No role reads this var: the token is
# entered by hand into Stalwart's setup wizard, which uses it to publish
# DNS records and to answer ACME DNS-01 challenges. It is kept here so the
# value lives in one place alongside everything else.
cloudflare_api_token: "{{ lookup('ansible.builtin.env', 'CLOUDFLARE_API_TOKEN') }}"

# --- firewall ---------------------------------------------------------------
# Ports reachable from the public internet. SSH is deliberately absent:
# sshd only listens on the Tailscale interface (see roles/lockdown).
# 587/143/110/995/4190 are deliberately left off, per Stalwart's own
# hardening guide, since 465+993 already cover encrypted submission + IMAP.
public_tcp_ports:
  - 25   # SMTP (inbound from other MTAs)
  - 465  # SMTP submission, implicit TLS (mail clients)
  - 993  # IMAPS (mail clients)
  - 80   # Caddy ACME HTTP-01 challenge + http->https redirect
  - 443  # HTTPS (Caddy: webmail + JMAP + webadmin)

# --- blob storage ---------------------------------------------------------
# Where message bodies, attachments and Sieve scripts are kept. Any
# S3-compatible provider works: Stalwart addresses them through a custom
# endpoint plus region name rather than an AWS region enum.
#
# Worth choosing deliberately given what this repo is for: mail bodies
# leaving the VPS land under whatever jurisdiction the provider sits in.
#
# No trailing slash on the endpoint: it is concatenated with object paths,
# and SigV4 signs the canonical URI, so a doubled slash surfaces as a
# signature mismatch rather than a clear error.
#
# Examples:
#   OVHcloud       endpoint https://s3.<region>.io.cloud.ovh.net
#                  region   <region>, e.g. bhs, gra, sbg, de, waw
#   Cloudflare R2  endpoint https://<account>.r2.cloudflarestorage.com
#                  region   auto
#   Backblaze B2   endpoint https://s3.<region>.backblazeb2.com
#                  region   <region>, e.g. eu-central-003
#   MinIO          endpoint https://minio.example.com
#                  region   us-east-1
s3_endpoint: "https://s3.{{ s3_region }}.io.cloud.ovh.net"
s3_region: CHANGEME_S3_REGION
s3_bucket: CHANGEME_S3_BUCKET
s3_key_prefix: ""     # optional, leave empty for none
s3_access_key: "{{ lookup('ansible.builtin.env', 'S3_ACCESS_KEY') }}"
s3_secret_key: "{{ lookup('ansible.builtin.env', 'S3_SECRET_KEY') }}"

# --- mail stack ---------------------------------------------------------

bulwark_internal_port: 3000

# Encrypts Bulwark's persistent "remember me" sessions, settings sync and
# server-side OAuth PKCE state. Without it Bulwark logs "Failed to store
# Stalwart auth context {error: SESSION_SECRET not configured}" and TOTP
# login never completes. Generate with `openssl rand -base64 32`.
bulwark_session_secret: CHANGEME_BULWARK_SESSION_SECRET

# Bulwark's admin dashboard (/admin on the webmail hostname). Without it the
# dashboard stays disabled, and its "Auto-configure OAuth" action is what
# registers Bulwark as an OAuth client with Stalwart 1.0. Bulwark only reads
# this while it has no admin.json yet, hashes it into that file, and ignores
# it from then on: change the password in the dashboard afterwards, or
# delete {{ data_dir }}/bulwark/admin/admin.json to reset it from here.
# Generate with `openssl rand -base64 24`.
bulwark_admin_password: CHANGEME_BULWARK_ADMIN_PASSWORD

# The mail stack's private Docker network. Pinned because Stalwart must be
# told this range is a reverse proxy: without it, it reads Caddy's address
# as the client address for every proxied request, attributes the internet's
# scanner traffic to Caddy, and bans it - which takes the admin console and
# webmail down with it. Change these only if they collide with another
# network on the host.
mailstack_subnet_v4: 172.18.0.0/16
mailstack_subnet_v6: fd00:dead:beef:1::/64

# --- stalwart declarative configuration -----------------------------------
# roles/mailstack renders these into two plans and applies them with
# stalwart-cli. There is no setup wizard: a fresh server is provisioned from
# this file. Re-running the playbook reconciles the infrastructure settings
# (DNS provider token, listeners, logging, S3, CORS, proxy networks) on a
# live server; the domain and stalwart_accounts are seed-only, applied once
# at provisioning and owned by the admin console from then on.
#
# Passwords live here rather than in .env because there is one per account.
# all.yml is gitignored, but `ansible-vault encrypt` on this file is the
# right move if the checkout is ever shared.

# Pin an exact release, the same one as mise.toml; the CLI ships separately
# from the server and versions independently of it. The playbook pulls this
# tag on every run. A CLI older than the server can fail to parse its
# schema (1.0.12 against Stalwart 1.0.2), so bump it when the server moves.
stalwart_cli_image: ghcr.io/stalwartlabs/cli:1.0.14

# Temporary credential used only while provisioning a fresh server, before
# any account exists. Stalwart treats it as a backdoor that bypasses the
# directory, so the role sets it exclusively in the recovery-mode overlay
# and recreates the container without it once the plan has been applied.
stalwart_recovery_password: CHANGEME_RECOVERY_PASSWORD

# The account the playbook authenticates as when applying the plan to an
# already-provisioned server. Must name one of stalwart_accounts, with
# role Admin. Its password here must keep matching the server's: the seed
# sets it once, and a change in the console is not pushed back.
stalwart_admin_account: admin

# Seed accounts, created once while provisioning a fresh server. name is
# the local part; the address becomes name@{{ domain }}. role is Admin or
# User. Editing or removing an entry later changes nothing on a live
# server: add, change and delete accounts in the admin console.
# Stalwart's network listeners. These do NOT exist by default: the setup
# wizard creates them, and a server provisioned declaratively through
# recovery mode starts with only the management listener on 8080. Without
# this list Stalwart answers nothing on 25/465/993 and the ports refuse
# connections from outside even though Docker is publishing them.
#
# Keep in step with public_tcp_ports above and with the compose file's
# published ports. tls_implicit false on 25 means STARTTLS, which is what
# port 25 expects; 465/993/443 are implicit TLS.
#
# pop3s (995) and manageSieve (4190) are deliberately absent, matching the
# hardening note on public_tcp_ports. Add them here if you want them.
stalwart_listeners:
  - { name: smtp,        protocol: smtp, port: 25,   tls_implicit: false }
  - { name: submissions, protocol: smtp, port: 465,  tls_implicit: true }
  - { name: imaps,       protocol: imap, port: 993,  tls_implicit: true }
  - { name: https,       protocol: http, port: 443,  tls_implicit: true }
  # Plaintext, reached only by Caddy over the internal Docker network.
  - { name: http,        protocol: http, port: 8080, tls_implicit: false, use_tls: false }

stalwart_accounts:
  - name: admin
    description: System administrator
    role: Admin
    password: CHANGEME_ADMIN_PASSWORD

# Mail domains whose mta-sts, autoconfig, autodiscover and ua-auto-config
# hostnames Caddy should serve. Stalwart publishes those names in DNS as
# CNAMEs to mail_hostname, but on 443 they reach Caddy, which only gets
# certificates for names it is told about. Without an entry here, senders
# cannot fetch the domain's MTA-STS policy and mail clients cannot
# autoconfigure. Domains are added in the admin console, so add them here
# too and re-run the playbook. Leave out any domain whose DNS does not point
# those names at this server, or Caddy keeps retrying a certificate it can't
# get.
stalwart_web_domains:
  - "{{ domain }}"
