# Managed by Ansible - roles/mailstack. Re-run playbooks/10-site.yml to
# apply changes; do not edit by hand on the host.
#
# The project name is pinned rather than derived from the directory, so
# the network keeps a stable name that the stalwart-cli container can be
# attached to when provisioning.
name: mailstack

services:
  stalwart:
    image: stalwartlabs/stalwart:v0.16
    restart: unless-stopped
    # Keep this explicit even though it matches Docker's daemon default.
    # Changing the daemon default affects only newly-created containers;
    # changing this Compose field makes `up` recreate existing ones too.
    logging:
{% if ovh_ldp_enabled | default(false) | bool %}
      driver: journald
      options:
        tag: "{% raw %}{{.Name}}{% endraw %}"
{% else %}
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
{% endif %}
    # 8080 (plain HTTP JMAP/WebUI/admin) is reached by Caddy over the
    # internal network only - never published to the host. 25/465/993 are
    # Stalwart's own raw SMTP/IMAP TLS listeners, published directly since
    # Caddy can't proxy raw TCP.
    ports:
      - "25:25"
      - "465:465"
      - "993:993"
    # v0.16 replaced the old single /opt/stalwart volume with these two, and
    # the image declares both as VOLUME. Leaving either unmapped gets you an
    # anonymous volume, which `docker compose down` orphans rather than
    # deletes - the next `up` then starts with no config.json and drops
    # straight back into bootstrap mode. Both dirs are chowned to uid 2000
    # by roles/mailstack; see the task there for why.
    volumes:
      # config.json - the only Stalwart config left on disk in v0.16;
      # everything else is an object in the data store.
      - "{{ data_dir }}/stalwart/etc:/etc/stalwart"
      # RocksDB, local blobs, bootstrap registry.
      - "{{ data_dir }}/stalwart/data:/var/lib/stalwart"
    networks: [internal]

  caddy:
    # Built from caddy-config/Dockerfile, which COPYs the Caddyfile in at
    # build time - not bind-mounted. See that Dockerfile for why.
    build:
      context: "{{ mailstack_dir }}/caddy-config"
    restart: unless-stopped
    logging:
{% if ovh_ldp_enabled | default(false) | bool %}
      driver: journald
      options:
        tag: "{% raw %}{{.Name}}{% endraw %}"
{% else %}
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
{% endif %}
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - "{{ data_dir }}/caddy/data:/data"
      - "{{ data_dir }}/caddy/config:/config"
    # Aliases {{ mail_hostname }} to this container on Docker's embedded DNS,
    # so bulwark's server-side fetches to JMAP_SERVER_URL resolve straight to
    # Caddy instead of the public IP. Without this, a request to the public
    # hostname leaves the container, hits the host's own external interface,
    # and needs hairpin NAT to loop back in to the very container that made
    # it - unsupported here, so it times out rather than erroring outright.
    # Caddy still routes correctly since it matches on the Host/SNI header,
    # not on which interface the connection arrived over.
    networks:
      internal:
        aliases:
          - "{{ mail_hostname }}"

  bulwark:
    image: ghcr.io/bulwarkmail/webmail:1.9
    restart: unless-stopped
    logging:
{% if ovh_ldp_enabled | default(false) | bool %}
      driver: journald
      options:
        tag: "{% raw %}{{.Name}}{% endraw %}"
{% else %}
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
{% endif %}
    environment:
      PORT: "{{ bulwark_internal_port }}"
      JMAP_SERVER_URL: "https://{{ mail_hostname }}"
      # {{ mail_hostname }} resolves to Caddy's private address from this
      # network by design. Permit OAuth discovery to follow that trusted,
      # administrator-configured endpoint so TOTP access tokens can refresh.
      OAUTH_ALLOW_PRIVATE_ENDPOINTS: "true"
      SESSION_SECRET: "{{ bulwark_session_secret }}"
    volumes:
      - "{{ data_dir }}/bulwark/admin:/app/data/admin"
      - "{{ data_dir }}/bulwark/admin-state:/app/data/admin-state"
      - "{{ data_dir }}/bulwark/settings:/app/data/settings"
    networks: [internal]

networks:
  # enable_ipv6 is per-network - the daemon-level "ipv6" setting in
  # /etc/docker/daemon.json (roles/docker) only covers the default
  # bridge, not this custom one.
  #
  # Both subnets are pinned rather than left to Docker's address pool.
  # Stalwart's configuration has to name this network twice - as a trusted
  # proxy source, and on its IP allowlist - because Caddy reaches it from
  # here. An address Docker picked at random would drift on the next
  # rebuild and silently stop matching.
  internal:
    enable_ipv6: true
    ipam:
      config:
        - subnet: "{{ mailstack_subnet_v4 }}"
        - subnet: "{{ mailstack_subnet_v6 }}"
